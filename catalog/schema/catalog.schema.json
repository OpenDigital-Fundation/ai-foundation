{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "catalog.yaml",
  "type": "object",
  "required": ["version", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "artifacts": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["id", "type", "capability", "status", "owner"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"},
          "type": {"enum": ["skill", "agent", "workflow", "prompt", "rule", "hook", "mcp", "template", "knowledge"]},
          "capability": {"type": "string", "minLength": 10, "maxLength": 200},
          "status": {"enum": ["experimental", "stable", "deprecated"]},
          "owner": {"type": "string", "minLength": 1},
          "supersedes": {"type": "array", "items": {"$ref": "#/$defs/inventoryKey"}, "uniqueItems": true},
          "path": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "inventoryKey": {"type": "string", "pattern": "^[^:]+/[^:]+:(skill|agent|command|rule|hook|mcp):.+$"}
  }
}
