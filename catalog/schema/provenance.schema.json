{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PROVENANCE.yaml",
  "type": "object",
  "required": ["version", "files"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "files": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["path", "derived_from"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "derived_from": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source", "commit", "path", "license", "modification"],
              "additionalProperties": false,
              "properties": {
                "source": {"type": "string"},
                "commit": {"type": "string"},
                "path": {"type": "string"},
                "license": {"type": "string"},
                "modification": {"enum": ["base", "merged-section", "adapted", "rewritten"]}
              }
            }
          }
        }
      }
    }
  }
}
